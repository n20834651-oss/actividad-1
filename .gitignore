# Creado por https://www.toptal.com/developers/gitignore/api/windows,visualstudiocode,c
# Editar en https://www.toptal.com/developers/gitignore?templates=windows,visualstudiocode,c

### C ###
# Requisitos previos
*.d

# Archivos de objeto
*.o
*.ko
*.obj
*.elf

# Salida del enlazador
*.ilk
*.map
*.exp

# Encabezados precompilados
*.gch
*.pch

# Bibliotecas
*.lib
*.a
*.la
*.lo

# Objetos compartidos (incluidas las DLL de Windows)
*.dll
*.so
*.so.*
*.dylib

# Ejecutables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Archivos de depuración
*.dSYM/
*.su
*.idb
*.pdb

# Resultados de la compilación del módulo del kernel
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

### Código de Visual Studio ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Historial local para Visual Studio Code
.history/

# Extensiones de Visual Studio Code creadas
*.vsix

### Parche de VisualStudioCode ###
# Ignorar todo el historial local de archivos
.historial
.iónido

### Windows ###
# Archivos de caché de miniaturas de Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Archivo de volcado
*.stackdump

# Archivo de configuración de la carpeta
[Dd]esktop.ini

# Papelera de reciclaje utilizada en recursos compartidos de archivos
$RECYCLE.BIN/

# Archivos del instalador de Windows
*.cab
*.msi
*.msix
*.msm
*.msp

# Accesos directos de Windows
*.lnk

# Fin de https://www.toptal.com/developers/gitignore/api/windows,visualstudiocode,c